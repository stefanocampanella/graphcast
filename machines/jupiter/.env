# Modules to load
MODULES=(CUDA/13)
# GraphCast Apptainer image
APPTAINER_IMAGE=/e/project1/e-dev-2026d09-119/graphcast/graphcast.sif
APPTAINERENV_PYTHONPATH=/e/project1/e-dev-2026d09-119/graphcast/src
# Default paths
DATA_ROOT=/e/fscratch/e-dev-2026d09-119/graphcast/data
DATASET_SQSH=/e/project1/e-dev-2026d09-119/arco-ocean-data.sqsh
CLIMATOLOGY_SQSH=/e/project1/e-dev-2026d09-119/arco-ocean-climatology.sqsh
ANOMALY_STD_SQSH=/e/project1/e-dev-2026d09-119/arco-ocean-anomaly_std.sqsh
TENDENCY_STD_SQSH=/e/project1/e-dev-2026d09-119/arco-ocean-tendency_std.sqsh
# XLA performance related flags
XLA_FLAGS="--xla_gpu_enable_triton_softmax_fusion=true \
           --xla_gpu_triton_gemm_any=True \
           --xla_gpu_enable_async_collectives=true \
           --xla_gpu_enable_latency_hiding_scheduler=true \
           --xla_gpu_enable_highest_priority_async_stream=true"
# Flags to consider for memory optimizations
#XLA_PYTHON_CLIENT_MEM_FRACTION=.75
#JAX_MEMORY_FITTING_EFFORT=1.0
#JAX_MEMORY_FITTING_LEVEL=O3
# The following might solve memory fragmentation issues
#TF_GPU_ALLOCATOR=cuda_malloc_async
# Performance optimization flags, as for: https://docs.jax.dev/en/latest/gpu_performance_tips.html
#JAX_ENABLE_PGLE=true
#JAX_PGLE_PROFILING_RUNS=3
#JAX_PGLE_AGGREGATION_PERCENTILE=85
# FIXME: Enabling compilation cache appears to cause errors on all ranks but 0, with
#  the following error message:
#  >> jaxlib._jax.XlaRuntimeError: INVALID_ARGUMENT:
#  >> Expected args to execute_sharded_on_local_devices to have 0 shards, got: ...
#  Probably due to an XLA bug, see: https://github.com/openxla/xla/pull/27683.
#  Upstream JAX has a fix for it, check that newer versions solve the issue.
#JAX_COMPILATION_CACHE_DIR="${LEONARDO_FAST_ROOT}/.jax_cache"
# Other flags to consider for execution time optimization
#JAX_OPTIMIZATION_LEVEL=O3
# Could it reduce compilation time on large multi-host setups?
#JAX_SHARE_BINARY_BETWEEN_HOSTS=True
# Debugging flags
#JAX_TRACEBACK_FILTERING=off
#JAX_TRACEBACK_IN_LOCATIONS_LIMIT=-1
# When debugging multi-host setups, might be useful
#JAX_DISTRIBUTED_DEBUG=True
#JAX_TRANSFER_GUARD_*=log
# Flags to consider for OOM debugging
#JAX_LOG_CHECKPOINT_RESIDUALS=True
# Other debugging flags
#JAX_PPRINT_USE_COLOR=True
# NCCL flags
# FIXME: Occasionally, some of the ranks will fail with the following error message:
#     >> INTERNAL: NCCL operation ncclGroupEnd() failed: unhandled system error (run with NCCL_DEBUG=INFO for details).
#     >> Last NCCL warning(error) log entry (may be unrelated) ''
#   Debug messages can be logged with the following, however they appear not informative. Instead, disabling infiniband,
#   as suggested here: https://github.com/NVIDIA/nccl/issues/694, solves the issue. Impact on performance is still to be
#   investigated.
#NCCL_DEBUG=INFO
#NCCL_IB_DISABLE=1
# Suppress harmless warnings
# Try to suppress warnings from TensorFlow/Keras and XLA
#TF_CPP_MIN_LOG_LEVEL=3
# Suppress Python warnings polluting log files (mostly related to protobuf gencode version)
#PYTHONWARNINGS='ignore:::google.protobuf.runtime_version,ignore::FutureWarning'
# Might suppress warnings related to TPU backend
#JAX_PLATFORMS=cuda
