#!/usr/bin/env bash
# GraphCast training benchmark job, generated by JUBE from clusters/jupiter/benchmarks/jube/train_bench.sbatch.in.
#SBATCH --job-name=gc-bench-#WPID#
#SBATCH --account=#ACCOUNT#
#SBATCH --partition=#PARTITION#
#RESERVATION#
#SBATCH --time=#TIMELIMIT#
#SBATCH --nodes=#NODES#
#SBATCH --ntasks-per-node=#TASKS_PER_NODE#
#SBATCH --cpus-per-task=#CPUS_PER_TASK#
#SBATCH --gres=gpu:#TASKS_PER_NODE#
#SBATCH --gpu-bind=single:1
#SBATCH --output=job.out
#SBATCH --error=job.err

set -uo pipefail
WORK_DIR=$PWD
# Always signal JUBE that this workpackage finished, also on failure or time limit (SIGTERM).
trap 'touch "#READY_FILE#"' EXIT
trap 'echo "BENCH_STATUS: terminated"; exit 143' TERM

# Site defaults first, then this case's dataset, Grain and zarr settings.
MODULES=()
set -a
# shellcheck source=/dev/null
source "#ENV_FILE#"
DATASET="#DATASET#"
CLIMATOLOGY="#CLIMATOLOGY#"
ANOMALY_STD="#ANOMALY_STD#"
TENDENCY_STD="#TENDENCY_STD#"
GRAPHCAST_GRAIN_NUM_WORKERS=#NUM_WORKERS#
GRAPHCAST_GRAIN_NUM_THREADS=#NUM_THREADS#
GRAPHCAST_GRAIN_PREFETCH_BUFFER_SIZE=#PREFETCH_BUFFER_SIZE#
GRAPHCAST_GRAIN_PER_WORKER_BUFFER_SIZE=#PER_WORKER_BUFFER_SIZE#
# Profiling servers in workers would perturb the measurement.
GRAPHCAST_GRAIN_ENABLE_PROFILING=false
ZARR_THREADING__MAX_WORKERS=#ZARR_MAX_WORKERS#
ZARR_ASYNC__CONCURRENCY=#ZARR_CONCURRENCY#
# srun does not inherit --cpus-per-task from sbatch (Slurm >= 22.05).
SRUN_CPUS_PER_TASK=#CPUS_PER_TASK#
set +a

for MODULE in ${MODULES[@]+"${MODULES[@]}"}; do
    module load "$MODULE"
done

echo "BENCH_CASE: #CASE#"
echo "BENCH_JOB: id=${SLURM_JOB_ID} nodes=${SLURM_JOB_NODELIST}"
echo "BENCH_START: $(date --iso-8601=seconds)"
START=$(date +%s)

srun --export=ALL --kill-on-bad-exit=1 --output="$WORK_DIR/task-%t.out" --error="$WORK_DIR/task-%t.err" \
    "#PROJECT_DIR#/scripts/train.sh" --project-dir "#PROJECT_DIR#" --config-dir "$WORK_DIR" \
    --output-dir "$WORK_DIR/model" --train-dir "$WORK_DIR/checkpoints" --tb-dir "$WORK_DIR/tensorboard" \
    --overwrite --log-level=info bench final train
STATUS=$?

echo "BENCH_STATUS: $STATUS"
echo "BENCH_ELAPSED: $(( $(date +%s) - START )) s"
# Peak resident memory over all tasks of the training step, in GB.
sacct -j "${SLURM_JOB_ID}.0" --noheader --parsable2 --format=MaxRSS 2>/dev/null | awk '
    function gb(v) { u = substr(v, length(v)); n = v + 0
        return u == "K" ? n / 2^20 : u == "M" ? n / 2^10 : u == "G" ? n : u == "T" ? n * 2^10 : n / 2^30 }
    $1 != "" { m = gb($1) > m ? gb($1) : m } END { printf "BENCH_MAXRSS: %.1f GB\n", m }'
# Checkpoints and the saved model are not needed for the analysis.
rm -rf -- "$WORK_DIR/checkpoints" "$WORK_DIR/model"
exit "$STATUS"
