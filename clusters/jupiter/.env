# Sourced by Bash, not a generic dotenv parser; MODULES is a Bash array.
# Runtime modules
MODULES=(CUDA/13)

# Image and source code
APPTAINER_IMAGE=/e/project1/e-dev-2026d09-119/graphcast/graphcast.sif
APPTAINERENV_PYTHONPATH=/e/project1/e-dev-2026d09-119/graphcast/src

# Writable storage, read-only inputs (SquashFS files or directories), and geometry path
DATA_ROOT=/e/fscratch/e-dev-2026d09-119/graphcast/data
DATASET=/e/project1/e-dev-2026d09-119/arco-ocean-data.sqsh
CLIMATOLOGY=/e/project1/e-dev-2026d09-119/arco-ocean-climatology.sqsh
ANOMALY_STD=/e/project1/e-dev-2026d09-119/arco-ocean-anomaly_std.sqsh
TENDENCY_STD=/e/project1/e-dev-2026d09-119/arco-ocean-tendency_std.sqsh
GEOMETRY_DIR=/e/project1/e-dev-2026d09-119/graphcast/data/geometry

# Zarr I/O settings, inherited by Grain's spawned workers (zarr.config.set in Python would not reach them).
# The default pool is min(32, cpus + 4) threads per process; ~4 per Grain reader thread matched it on the login node.
ZARR_THREADING__MAX_WORKERS=8
# Concurrent chunk requests per array read (default 10); helped a single reader, no measurable gain with 2.
ZARR_ASYNC__CONCURRENCY=32

# Grain reader and multiprocessing settings, read by graphcast.grain_utils.GrainRuntimeConfig (ignored when
# grain_dataset.pick_performance_config is set). NUM_WORKERS=0 disables multiprocessing.
# Grain's iterator state depends on NUM_WORKERS: checkpoints must be restored with the value they were saved with.
# Up to NUM_WORKERS * PER_WORKER_BUFFER_SIZE samples (~0.7 GB each) are buffered in shared memory.
GRAPHCAST_GRAIN_NUM_THREADS=2
GRAPHCAST_GRAIN_PREFETCH_BUFFER_SIZE=2
GRAPHCAST_GRAIN_NUM_WORKERS=8
GRAPHCAST_GRAIN_PER_WORKER_BUFFER_SIZE=2
GRAPHCAST_GRAIN_ENABLE_PROFILING=true

# Active XLA performance settings
XLA_FLAGS="--xla_gpu_enable_triton_softmax_fusion=true \
           --xla_gpu_triton_gemm_any=True \
           --xla_gpu_enable_async_collectives=true \
           --xla_gpu_enable_latency_hiding_scheduler=true \
           --xla_gpu_enable_highest_priority_async_stream=true"

# Disabled memory/performance experiments
#XLA_PYTHON_CLIENT_MEM_FRACTION=.75
#JAX_MEMORY_FITTING_EFFORT=1.0
#JAX_MEMORY_FITTING_LEVEL=O3
# The following might solve memory fragmentation issues
#TF_GPU_ALLOCATOR=cuda_malloc_async
# Performance optimization flags, as for: https://docs.jax.dev/en/latest/gpu_performance_tips.html
#JAX_ENABLE_PGLE=true
#JAX_PGLE_PROFILING_RUNS=3
#JAX_PGLE_AGGREGATION_PERCENTILE=85
# Cache can fail on nonzero ranks: INVALID_ARGUMENT, expected 0 shards.
# Check newer JAX/XLA releases: https://github.com/openxla/xla/pull/27683.
#JAX_COMPILATION_CACHE_DIR="${DATA_ROOT}/.jax_cache"
# Other flags to consider for execution time optimization
#JAX_OPTIMIZATION_LEVEL=O3
# Could it reduce compilation time on large multi-host setups?
#JAX_SHARE_BINARY_BETWEEN_HOSTS=True

# Distributed/NCCL troubleshooting
#JAX_DISTRIBUTED_DEBUG=True
# Some ranks occasionally fail at ncclGroupEnd() with an unhandled system error.
# Disabling InfiniBand helped; performance impact remains untested:
# https://github.com/NVIDIA/nccl/issues/694. NCCL_DEBUG alone was uninformative.
#NCCL_DEBUG=INFO
#NCCL_IB_DISABLE=1

# Warning/debug controls
#JAX_TRACEBACK_FILTERING=off
#JAX_TRACEBACK_IN_LOCATIONS_LIMIT=-1
#JAX_TRANSFER_GUARD_*=log
#JAX_LOG_CHECKPOINT_RESIDUALS=True
#JAX_PPRINT_USE_COLOR=True
# Try to suppress warnings from TensorFlow/Keras and XLA
#TF_CPP_MIN_LOG_LEVEL=3
# Suppress Python warnings polluting log files (mostly related to protobuf gencode version)
#PYTHONWARNINGS='ignore:::google.protobuf.runtime_version,ignore::FutureWarning'
# Might suppress warnings related to TPU backend
JAX_PLATFORMS=cuda

NCCL_SOCKET_IFNAME=ib0
GLOO_SOCKET_IFNAME=ib0
NCCL_IB_TIMEOUT=100
UCX_RC_TIMEOUT=4s
NCCL_IB_RETRY_CNT=10