# Sourced by Bash, not a generic dotenv parser; MODULES is a Bash array.
# Runtime modules
MODULES=(CUDA/13)

# Image and source code
APPTAINER_IMAGE=/e/project1/e-dev-2026d09-119/graphcast/graphcast.sif
APPTAINERENV_PYTHONPATH=/e/project1/e-dev-2026d09-119/graphcast/src

# Writable storage, read-only inputs (SquashFS files or directories), and geometry path
DATA_ROOT=/e/fscratch/e-dev-2026d09-119/graphcast/data
# Standardized anomalies (graphcast download) and mask (graphcast download-mask). Other layouts of the same data:
# zarr_v3_lexi, zarr_v3_colexi, and SquashFS images of each:
#DATASET=/e/fscratch/e-dev-2026d09-119/graphcast/data/anomalies/squashfs/zarr_v2.sqsh
#DATASET=/e/fscratch/e-dev-2026d09-119/graphcast/data/anomalies/squashfs/zarr_v3_lexi.sqsh
#DATASET=/e/fscratch/e-dev-2026d09-119/graphcast/data/anomalies/squashfs/zarr_v3_colexi.sqsh
DATASET=/e/fscratch/e-dev-2026d09-119/graphcast/data/anomalies/zarr_v2
MASK=/e/fscratch/e-dev-2026d09-119/graphcast/data/anomalies/glorys_mask
# graphcast compute-tendency-std of zarr_v2 (0 at constant points; the arco-make copy is incompatible: NaN, no masks).
TENDENCY_STD=/e/fscratch/e-dev-2026d09-119/graphcast/data/anomalies/tendency_std
GEOMETRY_DIR=/e/project1/e-dev-2026d09-119/graphcast/data/geometry

# zarr-python I/O settings, inherited by Grain's spawned workers (zarr.config.set in Python would not reach them).
# They apply to tendency_std and the mask; the standardized anomalies are read with TensorStore (dataset.io_threads).
# The default pool is min(32, cpus + 4) threads per process; ~4 per Grain reader thread matched it on the login node.
ZARR_THREADING__MAX_WORKERS=8
# Concurrent chunk requests per array read (default 10); helped a single reader, no measurable gain with 2.
ZARR_ASYNC__CONCURRENCY=32

# Grain reader and multiprocessing settings, read by graphcast.grain_utils.GrainRuntimeConfig (ignored when
# grain_dataset.pick_performance_config is set). NUM_WORKERS=0 disables multiprocessing.
# Grain's iterator state depends on NUM_WORKERS: checkpoints must be restored with the value they were saved with.
# Up to NUM_WORKERS * PER_WORKER_BUFFER_SIZE samples (~5.7 GB each at 50 levels) are buffered in shared memory.
# At 50 levels every setting from 0 x 4 to 4 x 2 keeps the GPUs busy (JUBE loader sweep, 29 Oct 2026); node memory
# peaks at 600-630 GB with 1 worker, ~840 GB (of 858) with 4, and 8 workers run out of it.
GRAPHCAST_GRAIN_NUM_THREADS=2
GRAPHCAST_GRAIN_PREFETCH_BUFFER_SIZE=2
GRAPHCAST_GRAIN_NUM_WORKERS=1
GRAPHCAST_GRAIN_PER_WORKER_BUFFER_SIZE=2
# Profiling servers in the workers cost time.
GRAPHCAST_GRAIN_ENABLE_PROFILING=false

# Active XLA performance settings. The container image sets XLA_FLAGS itself, which takes precedence over the
# host's XLA_FLAGS: pass them as APPTAINERENV_XLA_FLAGS. XLA aborts on unknown flags; this XLA no longer knows
# --xla_gpu_enable_triton_softmax_fusion nor --xla_gpu_enable_async_collectives (async collectives are the default).
# With the coarse mesh these flags made no measurable difference (JUBE opt sweep, 2026-10-22).
APPTAINERENV_XLA_FLAGS="--xla_gpu_enable_latency_hiding_scheduler=true \
                        --xla_gpu_triton_gemm_any=true \
                        --xla_gpu_enable_highest_priority_async_stream=true"

# Disabled memory/performance experiments
# JAX preallocates 75% of GPU memory by default; GraphCast with 16 message passing steps (coarse mesh) needs more.
XLA_PYTHON_CLIENT_MEM_FRACTION=.95
#JAX_MEMORY_FITTING_LEVEL=O3
# The following might solve memory fragmentation issues
#TF_GPU_ALLOCATOR=cuda_malloc_async
# Performance optimization flags, as for: https://docs.jax.dev/en/latest/gpu_performance_tips.html
# PGLE added ~25 s of startup (profiling runs) for no measurable gain; its profile was empty ("Found 0
# instructions from the profile").
#JAX_ENABLE_PGLE=true
#JAX_PGLE_PROFILING_RUNS=3
#JAX_PGLE_AGGREGATION_PERCENTILE=85
# Cache used to fail on nonzero ranks (INVALID_ARGUMENT, expected 0 shards, https://github.com/openxla/xla/pull/27683);
# with the JAX 0.11 image it works on 1 node (4 ranks). Its startup saving is not measured yet.
#JAX_COMPILATION_CACHE_DIR="${DATA_ROOT}/.jax_cache"
# Other flags to consider for execution time optimization
#JAX_OPTIMIZATION_LEVEL=O3
# Hangs at the first compilation on 2 nodes (all ranks waiting, GPUs idle): do not enable.
#JAX_SHARE_BINARY_BETWEEN_HOSTS=True

# Distributed/NCCL troubleshooting
#JAX_DISTRIBUTED_DEBUG=True
# Some ranks occasionally fail at ncclGroupEnd() with an unhandled system error.
# Disabling InfiniBand helped; on 2 nodes with the coarse mesh it cost nothing measurable:
# https://github.com/NVIDIA/nccl/issues/694. NCCL_DEBUG alone was uninformative.
#NCCL_DEBUG=INFO
#NCCL_IB_DISABLE=1

# Warning/debug controls
#JAX_TRACEBACK_FILTERING=off
#JAX_TRACEBACK_IN_LOCATIONS_LIMIT=-1
#JAX_TRANSFER_GUARD_*=log
#JAX_LOG_CHECKPOINT_RESIDUALS=True
#JAX_PPRINT_USE_COLOR=True
# Try to suppress warnings from TensorFlow/Keras and XLA
#TF_CPP_MIN_LOG_LEVEL=3
# Suppress Python warnings polluting log files (mostly related to protobuf gencode version)
#PYTHONWARNINGS='ignore:::google.protobuf.runtime_version,ignore::FutureWarning'
# Might suppress warnings related to TPU backend
JAX_PLATFORMS=cuda

NCCL_SOCKET_IFNAME=ib0
GLOO_SOCKET_IFNAME=ib0
NCCL_IB_TIMEOUT=100
UCX_RC_TIMEOUT=4s
NCCL_IB_RETRY_CNT=10